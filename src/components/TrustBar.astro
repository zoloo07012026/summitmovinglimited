---
import Icon from './Icon.astro';
import { stat } from '../lib/site';
import type { TrustItemSchema } from '../lib/schema';
import type { z } from 'astro/zod';

/**
 * The four cells under the hero copy.
 *
 * Two of them are figures rather than claims -- "Moves completed" and
 * "Customer rating" -- and both are blank on purpose. A blank heading renders
 * as an em-dash, which is this site's way of saying there is no verified
 * number yet rather than inventing one.
 */
interface Props {
  items: z.infer<typeof TrustItemSchema>[];
}

const { items } = Astro.props;
---

<div class="trust-bar">
  {
    items.map((item) => (
      <div class="trust-item">
        <div class="trust-icon">
          <Icon name={item.icon} />
        </div>
        <div>
          <h4>{stat(item.heading)}</h4>
          <p>{item.text}</p>
        </div>
      </div>
    ))
  }
</div>

<style>
  .trust-bar {
    margin-top: 20px;
    background: var(--card-bg);
    backdrop-filter: blur(10px);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    box-shadow: var(--shadow-md);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    padding: 6px;
  }
  .trust-item {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 10px;
    padding: 12px;
    border-right: 1px solid var(--card-border);
    border-bottom: 1px solid var(--card-border);
  }
  .trust-item:nth-child(2n) {
    border-right: none;
  }
  .trust-item:nth-child(n + 3) {
    border-bottom: none;
  }
  .trust-icon {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--blue-pale);
    color: var(--blue);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* :global because the <svg> comes from <Icon>, a separate component, and so
     never carries this component's scope attribute. The parent selector keeps
     it confined. Every icon rule on the site is written this way. */
  .trust-icon :global(svg) {
    width: 18px;
    height: 18px;
  }
  .trust-item h4 {
    font-size: 14px;
    font-weight: 800;
    margin-bottom: 1px;
  }
  .trust-item p {
    font-size: 12.5px;
    color: var(--grey-500);
    line-height: 1.32;
  }

  @media (max-width: 1080px) {
    .trust-bar {
      grid-template-columns: repeat(2, 1fr);
    }
    .trust-item {
      padding: 14px 18px;
      margin-bottom: 0;
    }
  }
  @media (max-width: 640px) {
    .trust-bar {
      grid-template-columns: 1fr;
      padding: 4px 0;
    }
    .trust-item {
      border-right: none;
      padding: 14px 18px;
      border-bottom: 1px solid var(--card-border);
    }
    .trust-item:nth-child(2n) {
      border-right: none;
    }
    .trust-item:nth-child(n + 3) {
      border-bottom: 1px solid var(--card-border);
    }
    .trust-item:nth-child(3) {
      border-bottom: 1px solid var(--card-border);
      padding-bottom: 14px;
    }
    .trust-item:last-child {
      border-bottom: none;
    }
  }
</style>
