---
import Icon from './Icon.astro';
import { homePage } from '../lib/pages';

const { why } = homePage;
---

<section class="section" id="about">
  <div class="why-section wrap">
    <div>
      <div class="eyebrow">{why.eyebrow}</div>
      <h2>
        {
          why.headingLines.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))
        }
      </h2>
      <p class="lead">{why.lead}</p>
      <ul class="why-points">
        {
          why.points.map((point) => (
            <li>
              <span class="ic">
                <Icon name={point.icon} />
              </span>
              <div>
                <h3>{point.heading}</h3>
                <p>{point.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

  </div>
</section>

<style>
  .why-section {
    /*
     * The photo underneath is a crew loading a truck, and at the original
     * 0.98/0.88 navy it was invisible at every screen size -- the panel read
     * as flat colour. Opened up to 0.93/0.82, which is as far as it goes: the
     * smallest text here is 14px #aebbdd, and over the photo's brightest pixel
     * 0.82 still leaves it at 5.1:1 against the 4.5:1 minimum. Lightening this
     * further starts failing contrast on a bright frame of the photo.
     */
    background:
      linear-gradient(135deg, rgba(12, 27, 58, 0.93), rgba(12, 27, 58, 0.82)), var(--image-why);
    background-size: cover;
    background-position: center;
    color: var(--white);
    border-radius: 16px;
    margin: 0 auto;
    padding: 58px 48px;
  }
  .why-section .eyebrow {
    color: #8fb3ff;
  }
  .why-section h2 {
    font-size: clamp(28px, 3.4vw, 38px);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.01em;
    margin-bottom: 18px;
  }
  .why-section p.lead {
    color: #c7d3ef;
    font-size: 16.5px;
    margin-bottom: 8px;
  }
  .why-points {
    margin-top: 24px;
  }
  .why-points li {
    display: flex;
    gap: 14px;
    margin-bottom: 18px;
    align-items: flex-start;
  }
  .why-points .ic {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: rgba(59, 123, 245, 0.18);
    color: #6ea0ff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }
  /* :global because <Icon> is a separate component and its <svg> never carries
     this component's scope attribute; the parent selector keeps it confined. */
  .why-points .ic :global(svg) {
    width: 16px;
    height: 16px;
  }
  .why-points h3 {
    font-size: 15.5px;
    font-weight: 700;
    margin-bottom: 3px;
  }
  .why-points p {
    font-size: 14px;
    color: #aebbdd;
    line-height: 1.5;
  }

  #about {
    padding-bottom: 18px;
  }

  @media (max-width: 1080px) {
    .why-section {
      padding: 44px 32px;
      border-radius: 14px;
    }
  }
  @media (max-width: 640px) {
    .why-section {
      padding: 36px 22px;
    }
    #about {
      padding-bottom: 12px;
    }
  }
</style>
