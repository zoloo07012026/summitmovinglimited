---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { homePage } from '../lib/pages';

/**
 * The four process steps.
 *
 * Same collection as /moving-guide/, which renders each entry's guideTitle.
 * Two of these images used to be remote Unsplash fetches while the other two
 * were local; all four are local now and go through astro:assets.
 *
 * .how-num sets font-size:0 and prints its data-short via ::after, so the
 * "STEP 01" text is for screen readers and the disc shows just the number.
 */
const steps = (await getCollection('steps')).sort((a, b) => a.data.order - b.data.order);
const { howHead: head, howCtaLabel } = homePage;

const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="section how-section" id="how">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">{head.eyebrow}</div>
      <h2>{head.heading}</h2>
      {head.text && <p>{head.text}</p>}
    </div>

    <div class="how-grid">
      {
        steps.map((step) => (
          <div class="how-card">
            <div class="how-media">
              {step.data.image && (
                <Image
                  src={step.data.image}
                  alt={step.data.imageAlt}
                  widths={[320, 640]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 25vw"
                />
              )}
              <div class="how-num" data-short={pad(step.data.order)}>
                STEP {pad(step.data.order)}
              </div>
            </div>
            <div class="how-icon">{step.data.icon && <Icon name={step.data.icon} />}</div>
            <h3>{step.data.title}</h3>
            <p>{step.data.description}</p>
          </div>
        ))
      }
    </div>

    <div class="section-cta">
      <a href="#quote" class="btn btn-primary">
        {howCtaLabel}
        <Icon name="arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .how-section {
    position: relative;
    background:
      linear-gradient(180deg, rgba(246, 249, 253, 0.96), rgba(246, 249, 253, 0.92)),
      var(--image-how);
    background-size: cover;
    background-position: center;
    overflow: hidden;
  }
  .how-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 0%, rgba(30, 95, 217, 0.12), transparent 34%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.34), rgba(255, 255, 255, 0.76));
    pointer-events: none;
  }
  .how-section .wrap {
    position: relative;
    z-index: 1;
  }
  .how-section .section-head {
    max-width: 780px;
    margin-bottom: 38px;
  }
  .how-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 8px;
    position: relative;
  }
  .how-grid::before {
    content: '';
    position: absolute;
    left: 8%;
    right: 8%;
    top: 34px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(30, 95, 217, 0.18), transparent);
    z-index: 0;
  }
  .how-card {
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
    border-radius: 18px;
    padding: 0 24px 28px 28px;
    border: 1px solid var(--card-border);
    position: relative;
    overflow: hidden;
    box-shadow: 0 14px 36px rgba(12, 27, 58, 0.08);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    z-index: 1;
  }
  .how-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 156px;
    bottom: 28px;
    width: 4px;
    border-radius: 0 999px 999px 0;
    background: var(--blue);
  }
  .how-card::after {
    content: '';
    position: absolute;
    right: -38px;
    top: -42px;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: rgba(30, 95, 217, 0.06);
  }
  .how-card:hover {
    transform: translateY(-4px);
    border-color: #c6d8f4;
    box-shadow: 0 22px 54px rgba(12, 27, 58, 0.14);
  }
  .how-num {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: var(--orange);
    color: #fff;
    box-shadow: 0 12px 28px rgba(255, 117, 31, 0.26);
    font-size: 0;
    margin-bottom: 22px;
  }
  .how-num::after {
    content: attr(data-short);
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 0;
  }
  .how-icon {
    position: relative;
    z-index: 1;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #f8fbff;
    color: var(--blue);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
    border: 1px solid var(--grey-200);
  }
  /* :global because <Icon> is a separate component and its <svg> never carries
     this component's scope attribute; the parent selector keeps it confined. */
  .how-icon :global(svg) {
    width: 23px;
    height: 23px;
  }
  .how-card h3 {
    position: relative;
    z-index: 1;
    font-size: 18px;
    font-weight: 800;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }
  .how-card p {
    position: relative;
    z-index: 1;
    font-size: 14.5px;
    color: var(--grey-700);
    line-height: 1.58;
  }
  .how-media {
    position: relative;
    height: 128px;
    margin: 0 -24px 24px -28px;
    overflow: hidden;
    border-radius: 18px 18px 0 0;
    background: #dbeafe;
  }
  .how-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.9) contrast(0.95);
  }
  .how-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(12, 27, 58, 0.36), rgba(30, 95, 217, 0.16));
  }
  .how-media .how-num {
    position: absolute;
    left: 20px;
    bottom: 16px;
    margin: 0;
  }
  .section-cta {
    display: flex;
    justify-content: center;
    margin-top: 34px;
  }

  @media (max-width: 1080px) {
    .how-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .how-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
