# Normalise to LF in the repo so the CMS (which always writes LF) does not
# show every content file as modified after a Windows checkout.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
