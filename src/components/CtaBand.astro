---
import Icon from './Icon.astro';
import { site, phoneHref } from '../lib/site';
import { QUOTE_HREF } from '../lib/nav';
import type { Cta } from '../lib/schema';

/**
 * The closing call-to-action band.
 *
 * The home page and the interior pages had drifted into two different designs:
 * a photo-backed band with two buttons, and a flat gradient band with one.
 * `variant` makes that a named choice rather than an accident of which
 * stylesheet happened to load -- see the note in interior.css.
 *
 * The `photo` styles live in this file scoped to `.is-photo`, so they can never
 * collide with `.is-interior .cta-band`: the two classes never co-occur.
 */
interface Props {
  cta: Cta;
  /** Where the primary button goes. Defaults to the quote form. */
  href?: string;
  variant?: 'photo' | 'flat';
  /** Anchor id on the <section>, e.g. "contact". */
  id?: string;
  /** Extra class on the <section>, e.g. "alt" or "service-cta-section". */
  sectionClass?: string;
  /** Extra class on the band, e.g. "service-cta". */
  bandClass?: string;
}

const {
  cta,
  href = QUOTE_HREF,
  variant = 'flat',
  id,
  sectionClass,
  bandClass,
} = Astro.props;
---

<section class:list={['section', sectionClass]} id={id}>
  <div class:list={['wrap', 'cta-band', bandClass, { 'is-photo': variant === 'photo' }]}>
    <h2>{cta.heading}</h2>
    <p>{cta.text}</p>
    {
      variant === 'photo' ? (
        <div class="cta-actions">
          <a href={href} class="btn btn-white">
            {cta.label}
            <Icon name="arrow" />
          </a>
          <a href={phoneHref} class="btn btn-ghost-white">
            <Icon name="phone" />
            {site.phone}
          </a>
        </div>
      ) : (
        <a href={href} class="btn btn-outline">
          {cta.label}
        </a>
      )
    }
  </div>
</section>

<style>
  /* Verbatim from index.html's inline CSS (the CTA Band block and its two
     media queries), narrowed to .is-photo so the interior band is untouched. */
  .cta-band.is-photo {
    background:
      linear-gradient(135deg, rgba(30, 95, 217, 0.86) 0%, rgba(23, 70, 163, 0.78) 100%),
      var(--image-cta);
    background-size: cover;
    background-position: center;
    border-radius: 14px;
    margin: 0 auto;
    padding: 54px 48px;
    text-align: center;
    color: var(--white);
  }
  .cta-band.is-photo h2 {
    font-size: clamp(26px, 3.2vw, 36px);
    font-weight: 800;
    margin-bottom: 14px;
    letter-spacing: -0.01em;
  }
  .cta-band.is-photo p {
    font-size: 16.5px;
    color: #dbe6ff;
    max-width: 560px;
    margin: 0 auto 30px;
  }
  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  /* Overrides the global .btn-white fill, home page only. */
  .cta-band.is-photo .btn-white {
    background: var(--orange);
    color: var(--white);
  }
  .cta-band.is-photo .btn-white:hover {
    background: var(--orange-dark);
  }

  @media (max-width: 1080px) {
    .cta-band.is-photo {
      padding: 44px 28px;
      border-radius: 12px;
    }
  }
  @media (max-width: 640px) {
    .cta-band.is-photo {
      padding: 40px 22px;
    }
  }
</style>
