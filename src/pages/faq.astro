---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqPage } from '../lib/pages';

const items = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title={faqPage.seo.title}
  description={faqPage.seo.description}
  active="company"
>
  <PageHero hero={faqPage.hero} panel={faqPage.panel} />
  <FaqList items={items} />
  <CtaBand cta={faqPage.cta} sectionClass="alt" />
</PageLayout>
